{
  "name": "starlantern",
  "version": "0.0.1",
  "description": "Starlantern — WebXR night-sky overlay locked to reality via phone-camera plate-solving. Prototype for AR-glasses astronomy.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "gen-catalog": "node scripts/build-catalog.mjs",
    "gen-tle": "node scripts/build-tle.mjs",
    "tunnel": "npx -y cloudflared tunnel --url http://localhost:5173"
  },
  "dependencies": {
    "satellite.js": "^5.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@vercel/node": "^5.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/<owner>/starlantern.git"
  },
  "homepage": "https://starlantern.app",
  "keywords": [
    "starlantern",
    "ar",
    "augmented-reality",
    "astronomy",
    "webxr",
    "night-sky",
    "plate-solving",
    "stellarium",
    "three.js"
  ]
}
